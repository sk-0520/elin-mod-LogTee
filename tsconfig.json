{
  "compilerOptions": {
    "lib": [
      "DOM",
      "ES2020"
    ],
    "target": "ES2020",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    /* modules */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    /* type checking */
    "noUnusedParameters": false,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "types": [
      "node"
    ],
  },
  "include": [
    "wwwroot/**/*.ts"
  ]
}
